+/**
+ * Report the view as ready only once it is in a window *and* has a real size.
+ *
+ * Moving to a window happens before the first layout pass, so reporting readiness
+ * there created the Filament surface — and the swapchain built from it — against a
+ * 0x0 drawable. The true size then arrived from `layoutSubviews` a few frames
+ * later, as a resize. Whether that resize landed before or after the render loop
+ * started was a race, and when it landed after, resizing the surface underneath
+ * in-flight frames segfaulted.
+ *
+ * Waiting for a size collapses both problems: the swapchain is created once, at
+ * the size it will keep, and the KVO observer that reports resizes is installed
+ * afterwards — so the startup resize it used to see no longer exists. A genuine
+ * later resize still goes down the old path; on a portrait-locked, full-screen
+ * view there isn't one.
+ */
+- (void)mountIfReady {
+  if (isMounted || self.window == nil || self.onViewReady == nil) {
+    return;
   }
+  CGSize size = self.metalLayer.drawableSize;
+  if (size.width <= 0 || size.height <= 0) {
+    return;
+  }
+
+  isMounted = true;
+  self.metalLayer.opaque = self.enableTransparentRendering ? NO : YES;
+  self.onViewReady(@{});
 }
 
