# Public, HTTPS address of the API used by a physical device or Release build.
# Do not put credentials or other secrets in EXPO_PUBLIC_ variables: Expo embeds
# them in the JavaScript bundle. Copy this file to .env.local for local testing.
EXPO_PUBLIC_API_URL=https://run-backend-ngyo.onrender.com
# Set true only in a POC/testing build to expose the virtual-run joystick.
EXPO_PUBLIC_ENABLE_SIMULATOR=true
