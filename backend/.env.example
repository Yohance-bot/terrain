# Local development. Homebrew PostgreSQL authenticates as the OS user by default,
# so no username or password is needed here.
DATABASE_URL=postgresql+psycopg://localhost:5432/run_prototype

# Required to enable /v1/admin/review internal operations. Keep this outside
# source control and rotate it before any non-local deployment.
ADMIN_OPERATIONS_TOKEN=replace-with-a-long-random-secret

# Matching parameters. See app/core/config.py.
MAX_ACCURACY_M=50
MIN_PRESENCE_M=100
PIPELINE_VERSION=1
# Kept independently from pipeline version for future persisted rule revisions.
RULESET_VERSION=1

TERRITORY_CITY=bengaluru
# M1 hand map: jayanagar. M2 pipeline publish: jayanagar_lalbagh
TERRITORY_AREA=jayanagar_lalbagh

# Log complete HTTP 422 response bodies in the backend terminal during local
# development. Set to false before any non-local deployment.
LOG_HTTP_422_RESPONSE_BODIES=true

# Local debug builds only. Keep this disabled for any shared or deployed backend.
DEVELOPER_MODE_ENABLED=false
DEVELOPER_MODE_PINS=2468,1357,9876
LOCAL_ACCOUNTS_ENABLED=false
